<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/SuppliesID"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="32dp"
        android:ems="10"
        android:hint="@string/hint_supplies"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/BeveragesID"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="@string/hint_beverage"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="@+id/SuppliesID"
        app:layout_constraintStart_toStartOf="@+id/SuppliesID"
        app:layout_constraintTop_toBottomOf="@+id/SuppliesID" />

    <EditText
        android:id="@+id/SnackID"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="@string/hint_snack"
        android:inputType="text"
        app:layout_constraintEnd_toEndOf="@+id/BeveragesID"
        app:layout_constraintStart_toStartOf="@+id/BeveragesID"
        app:layout_constraintTop_toBottomOf="@+id/BeveragesID" />

    <Button
        android:id="@+id/AddItemBtnID"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/btn_add_item"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/SnackID" />

</androidx.constraintlayout.widget.ConstraintLayout>